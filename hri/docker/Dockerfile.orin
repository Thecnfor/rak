# HRI Qt 开发/运行镜像 — 基于 NVIDIA 官方 L4T (JetPack 6.2, L4T r36.4.0, Ubuntu 22.04, aarch64)
#
# 设计取舍:
#   * 本机(x86_64, 无 GPU)与 Orin(目标机, 有 GPU)共用同一镜像, 保证 aarch64 产物零版本漂移
#   * 本机通过 QEMU binfmt 跑 aarch64 容器; Orin 原生运行
#   * 开发时无显示环境, 用 Qt offscreen 平台跑 GUI 逻辑测试; 部署到 Orin 用 xcb/eglfs + GPU
#
# 构建:  docker build -f docker/Dockerfile.dev -t hri-dev:r36.4.0 .
# 本机:  docker run --rm -it -v $(pwd):/workspace -e QT_QPA_PLATFORM=offscreen hri-dev:r36.4.0 bash
# Orin:  (需 nvidia-container-toolkit)
#        docker run --rm -it --runtime nvidia --gpus all -e DISPLAY=$DISPLAY \
#          -v /tmp/.X11-unix:/tmp/.X11-unix -v $(pwd):/workspace hri-dev:r36.4.0 \
#          /workspace/build/hri_app -platform xcb

FROM nvcr.io/nvidia/l4t-jetpack:r36.4.0

ENV DEBIAN_FRONTEND=noninteractive

# 构建工具链
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential g++ cmake ninja-build pkg-config git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Qt6 开发包 (Ubuntu 22.04 -> Qt 6.2)
RUN apt-get update && apt-get install -y --no-install-recommends \
    qt6-base-dev qt6-base-dev-tools qt6-declarative-dev qt6-tools-dev \
    qt6-qpa-plugins libqt6gui6 libqt6quick6 libqt6widgets6 \
    qml6-module-qt5compat-graphicaleffects \
    libgl1-mesa-dev libglvnd-dev libegl1 libgl1 \
    libxkbcommon-dev libxkbcommon-x11-0 \
    libxcb1-dev libxcb-cursor0 libxcb-xinerama0 libxcb-icccm4 \
    libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 \
    libxcb-shape0 libxcb-xfixes0 libxcb-xkb1 libx11-xcb1 libx11-dev libxext6 \
    libfontconfig1 libfreetype6 \
    xvfb fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

ARG UID=1000
RUN useradd -m -u ${UID} -s /bin/bash devuser \
    && mkdir -p /workspace/build && chown -R devuser:devuser /workspace

USER devuser
